# ─── API Gateway ─────────────────────────────────────────────────────────────
# Base URL of the .NET Core API Gateway (no trailing slash). Server-side only:
# `next dev` and Vercel proxy /api/* and /hubs/* to it (next.config.mjs
# rewrites); the browser only ever calls same-origin /api/*. Not needed for the
# static S3 build — CloudFront routes /api/* there.
# Don't use a NEXT_PUBLIC_ name for this: those are baked into the client JS
# bundle, which exposes the backend URL to anyone viewing the page source.
API_GATEWAY_URL=https://your-gateway-host

# ─── JWT Authentication ───────────────────────────────────────────────────────
# Secret used to verify HS256 JWT tokens issued by the .NET Auth service
# Must be at least 32 characters; keep this value server-side only
JWT_SECRET=your-256-bit-jwt-secret-replace-in-production

# ─── Academic API endpoints (relative to API_GATEWAY_URL) ────────────────────
# GET /api/v1/academic/grades          → student grade records
# GET /api/v1/academic/schedule        → course timetable
# GET /api/v1/academic/attendance      → attendance summary
# GET /api/v1/academic/courses         → enrolled course list
# POST /api/v1/auth/refresh            → JWT refresh

# ─── UI behaviour ────────────────────────────────────────────────────────────
# Duration (in seconds) before the success popup auto-closes after a save action.
NEXT_PUBLIC_SUCCESS_POPUP_DURATION=5

# Duration (in seconds) the "new notification" slide-in toast stays in the
# top-right corner before auto-dismissing. Recommended range: 5-7.
NEXT_PUBLIC_NOTIFICATION_TOAST_DURATION=6

# ─── Mock auth (no backend) ───────────────────────────────────────────────────
# Set to "true" to bypass the real API and allow login with any credentials.
# Client-side validation rules still apply. Set to "false" when the backend is live.
NEXT_PUBLIC_AUTH_MOCK=false

# ─── Role-based menu/access (sidebar + permissions) ───────────────────────────
# Independent of NEXT_PUBLIC_AUTH_MOCK above — controls only where the sidebar
# menu and page permissions come from. "true" = full-access mock menu (every
# page visible, no role restrictions); "false" = real /api/v1/users/me/menu,
# permission-gated per logged-in user's role. Leave unset to just follow
# NEXT_PUBLIC_AUTH_MOCK. Useful when you want real login but still want to
# toggle RBAC on/off without mocking every other API call too.
# NEXT_PUBLIC_RBAC_MOCK=false

# ─── Vercel-specific ─────────────────────────────────────────────────────────
# Set NEXTAUTH_URL to your Vercel deployment URL when using NextAuth
# NEXTAUTH_URL=https://isbat-academic.vercel.app
# NEXTAUTH_SECRET=your-nextauth-secret
