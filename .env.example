# ─── API Gateway ─────────────────────────────────────────────────────────────
# Base URL for the .NET Core API Gateway (no trailing slash)
NEXT_PUBLIC_API_GATEWAY_URL=https://api.isbat.ac.ug

# ─── JWT Authentication ───────────────────────────────────────────────────────
# Secret used to verify HS256 JWT tokens issued by the .NET Auth service
# Must be at least 32 characters; keep this value server-side only
JWT_SECRET=your-256-bit-jwt-secret-replace-in-production

# ─── Academic API endpoints (relative to API_GATEWAY_URL) ────────────────────
# GET /api/v1/academic/grades          → student grade records
# GET /api/v1/academic/schedule        → course timetable
# GET /api/v1/academic/attendance      → attendance summary
# GET /api/v1/academic/courses         → enrolled course list
# POST /api/v1/auth/refresh            → JWT refresh

# ─── Mock auth (no backend) ───────────────────────────────────────────────────
# Set to "true" to bypass the real API and allow login with any credentials.
# Client-side validation rules still apply. Set to "false" when the backend is live.
NEXT_PUBLIC_AUTH_MOCK=false

# ─── Vercel-specific ─────────────────────────────────────────────────────────
# Set NEXTAUTH_URL to your Vercel deployment URL when using NextAuth
# NEXTAUTH_URL=https://isbat-academic.vercel.app
# NEXTAUTH_SECRET=your-nextauth-secret
