meta {
  name: Approve Or Reject Program
  type: http
  seq: 9
}

put {
  url: {{baseUrl}}/api/v1/academic/program-approval
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "programGuid": "3fa85f64-5717-4562-b3fc-2c963f66afa6",
    "isApproved": true
  }
}

docs {
  Approves or rejects a program. `isApproved: true` approves, `false` rejects.

  Success (200): { "success": true, "data": null, "message": null, "code": null }
  Failure: 404 `not_found` if no program with that GUID.
}
