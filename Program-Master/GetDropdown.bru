meta {
  name: Get Program Dropdown
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/v1/academic/program-master/dropdown?facultyGuid=
  body: none
  auth: none
}

params:query {
  facultyGuid:
}

docs {
  Returns a flat list of programs (`programGuid`, `programName`) for selectors. Optionally filter by `facultyGuid`.

  Success (200): standard envelope, `data` is an array of `{ programGuid, programName }`.
}
