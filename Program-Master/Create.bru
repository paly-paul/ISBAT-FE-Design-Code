meta {
  name: Create Program
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/v1/academic/program-master
  body: multipartForm
  auth: none
}

body:multipart-form {
  programCode: BSCS
  programName: Bachelor of Science in Computer Science
  programLevelGuid: b2c3d4e5-f6a7-48b9-c0d1-e2f3a4b5c6d7
  pgmStatus: true
  noIa: false
  programGroupGuid: 7c9e6679-7425-40de-944b-e07fc1f90ae7
  unitCount: 24
  appFee: 50000
  lateFee: 10000
  facultyGuid: c3d4e5f6-a7b8-49c0-d1e2-f3a4b5c6d7e8
  currencyGuid: a1b2c3d4-e5f6-4789-abcd-ef0123456789
  dateAcc: 2022-01-15T00:00:00
  streamGuid: d4e5f6a7-b8c9-40d1-e2f3-a4b5c6d7e8f9
  intakeGuid: e5f6a7b8-c9d0-4e1f-a2b3-c4d5e6f7a8b9
}

docs {
  Creates a new program. Sent as multipart/form-data because an optional `accLetterFile` accreditation
  letter document can be attached (add it as a file part named `accLetterFile` in Bruno's multipart editor
  when testing an upload).

  Success (201): `data` is the created program object.
  Failure: 400 `validation_error` if programCode/programName missing or too long, programLevelGuid empty,
  or unitCount/appFee invalid.
}
