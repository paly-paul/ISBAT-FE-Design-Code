meta {
  name: Get Program Full Details
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/v1/academic/program-master/:programGuid/full-details
  body: none
  auth: none
}

params:path {
  programGuid: 3fa85f64-5717-4562-b3fc-2c963f66afa6
}

docs {
  Returns the full details of a program including semesters, all assigned course units, and the
  complete fee structure (headers + lines).

  Success (200): data contains:
    programGuid, programCode, programName, pgmStatus, noIa, programGroupGuid, unitCount,
    programLevelGuid, yearCount, semCount, facultyGuid, dateAcc, accLetter, appFee, lateFee,
    intakeGuid, streamGuids[], semesters[], programUnits[], feeStructures[].

  Each programUnit: semCode, courseUnitGuid, courseUnitCode, courseUnitName, streamGuid,
    streamName, unitTypeGuid, unitTypeName, unitCatGuid, unitCatName, flag.

  Each feeStructure: feeHdGuid, feeCode, feeDesc, status, localOrForeign, intakeGuid,
    calcType, amtPer, lef, cef, lec, cec, ace, acec, feeLines[].

  Each feeLine: semCode, ledgerGuid, currencyGuid, ledgerNum, amount.

  Failures: 404 not_found if no program with that GUID.
}
