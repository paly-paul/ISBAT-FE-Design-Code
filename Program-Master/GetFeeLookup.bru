meta {
  name: Get Fee Lookup By Program Level
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/v1/academic/program-master/fee-lookup/:programLevelGuid
  body: none
  auth: none
}

params:path {
  programLevelGuid: 3fa85f64-5717-4562-b3fc-2c963f66afa6
}

docs {
  Returns the default fee information for a program level, used to pre-populate fee fields when creating a program.

  Success (200): `data` is `{ feeCode, feeName, appFee, lateFee }`.
  Failure: 404 `not_found` if no fee data for the given program level.
}
