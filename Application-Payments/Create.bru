meta {
  name: Create Application Payment
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/admissions/application-payments
  body: multipartForm
  auth: none
}

body:multipart-form {
  enquiryGuid: f845dd47-8a78-4b43-a9a8-2acb73954f15
  oDelIntApplication: 0
  studentName: John Doe
  intakeGuid: 7c480182-8f3a-4829-9096-a0bd4248fdee
  campusGuid: 95cdfd77-ff2d-4173-a2d0-3d4f331a8b3c
  programGuid: 7ae14e45-379e-47b1-9b91-fa362bdbafad
  semesterGuid: d017d5b4-e59a-4514-a948-49f95d702afc
  batchGuid: 48e3d606-fa47-48ec-9645-15fd272b5446
  batchTimeGuid: 4557ffa3-e8c7-422d-a34c-72998cb65ba3
  feeHdGuid: 4a0d2b25-988f-4c4d-82cd-7a9b9e446fc1
  countryGuid: f607bc09-f0a6-4145-9e2a-f129c225edb2
  mobile: 700000000
  email: john.doe@example.com
  exemptionTypeGuid: 6dae5b7d-3f52-4872-9a77-9d244b9c7526
  payDate: 28/Jul/2026
  payType: 1
  amount: 50000.00
  currencyGuid: 22b10afb-b29f-4351-870a-568fb009981b
  exRate: 1.0
  bankGuid: f607bc09-f0a6-4145-9e6a-f129c225edb2
  receiptBookGuid: c1e7f96f-4fef-406e-b17f-7f9456fabc6e
  remarks: Application payment
  payProofFile: @file(C:\Users\sarve\Downloads\Saravanan Resume (1).pdf) @contentType(application/pdf)
}

vars:pre-request {
  baseUrl: http://erp-dev-alb-1794049924.eu-west-1.elb.amazonaws.com
}

docs {
  Records an application payment. Accepts multipart/form-data to support an optional payment proof file upload.
  
  Field notes:
  - `enquiryGuid` (optional): links the payment to an existing enquiry.
  - `programGuid`: GUID of the programme — stored directly; no integer lookup required.
  - `batchTimeGuid` replaces old `intBatchTime` integer field.
  - `feeHdGuid` replaces old `intFee` integer field.
  - `countryGuid` replaces old `countryCode` string field.
  - `exemptionTypeGuid` replaces old `exemptionType` integer field.
  - `payDate` must be in dd/MMM/yyyy format (e.g. 28/Jul/2026).
  - When `exemptionTypeGuid` is provided, `amount`, `currencyGuid`, `exRate`, `payType`, and `receiptBookGuid` are not required.
  - `bankGuid` is required when `payType > 1` (non-cash payments).
  
  Success (201): data = CreateApplicationPaymentResponse.
  Failure: 400 `validation_error` or `bad_request`.
}
