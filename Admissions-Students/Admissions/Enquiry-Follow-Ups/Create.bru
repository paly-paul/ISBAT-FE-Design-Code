meta {
  name: Create Enquiry Follow-Up
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/admissions/enquiry-followups
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "intEnquiry": 1,
    "advisorGuid": "3fa85f64-5717-4562-b3fc-2c963f66afa6",
    "followUpDate": "2026-07-21T00:00:00",
    "followUpStatus": 1,
    "followUpMode": 1,
    "enquiryStatus": 1,
    "interestLevel": null,
    "nextFollowDate": null,
    "remarks": "Called student, interested in Diploma program."
  }
}

vars:pre-request {
  baseUrl: https://localhost:44396
}

docs {
  Records a follow-up activity against an enquiry.
  
  Success (201): data = created EnquiryFollowUpDto.
  Failure: 400 `validation_error`.
}
