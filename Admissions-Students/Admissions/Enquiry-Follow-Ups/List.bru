meta {
  name: List Enquiry Follow-Ups
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/admissions/enquiry-followups?page=1&pageSize=10
  body: none
  auth: none
}

params:query {
  page: 1
  pageSize: 10
  date: ~
}

vars:pre-request {
  baseUrl: https://localhost:44396
}

docs {
  Returns a paginated list of all enquiry follow-ups. Optionally filter by date (ISO 8601).
  
  Success (200): data = PagedResult<EnquiryFollowUpListDto>.
}
