meta {
  name: Update Enquiry
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/api/v1/admissions/enquiries/:guid
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

params:path {
  guid: 3fa85f64-5717-4562-b3fc-2c963f66afa6
}

body:json {
  {
    "advisorGuid": "3fa85f64-5717-4562-b3fc-2c963f66afa6",
    "enquiryStatus": 1,
    "programGuid": "3fa85f64-5717-4562-b3fc-2c963f66afa6",
    "campusGuid": "3fa85f64-5717-4562-b3fc-2c963f66afa6"
  }
}

docs {
  Updates an existing enquiry (assign advisor, change status, assign program/campus).
  All fields are optional except `campusGuid`.

  Success (200): data = updated EnquiryDto.
  Failure: 404 `not_found`; 400 `validation_error`.
}
