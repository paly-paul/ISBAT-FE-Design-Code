meta {
  name: Get Application Summary
  type: http
  seq: 14
}

get {
  url: {{baseUrl}}/api/v1/admissions/application-filling/:intApplication/summary
  body: none
  auth: none
}

params:path {
  intApplication: 1
}

docs {
  Returns a high-level summary of an application including contact and payment info.

  Success (200): data = ApplicationContactSummaryDto.
  Failure: 404 `not_found`.
}
