meta {
  name: Filter Applications
  type: http
  seq: 13
}

get {
  url: {{baseUrl}}/api/v1/admissions/application-filling/filter
  body: none
  auth: none
}

params:query {
  gender: ~
  intCountryCode: ~

}

docs {
  Returns a list of application integer IDs matching the given filters.
  Both query params are optional.
  - `gender`: 0 = Female, 1 = Male
  - `intCountryCode`: integer country code

  Success (200): data = List<int> (intApplication IDs).
}
