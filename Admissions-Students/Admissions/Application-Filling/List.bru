meta {
  name: List Applications
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/admissions/application-filling/?page=1&pageSize=10
  body: none
  auth: none
}

params:query {
  page: 1
  pageSize: 10
}

docs {
  Returns a paginated list of applications.

  Success (200): data = PagedResult<ApplicationDetailDto>.
}
