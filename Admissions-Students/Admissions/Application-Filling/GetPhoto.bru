meta {
  name: Get Application Photo
  type: http
  seq: 15
}

get {
  url: {{baseUrl}}/api/v1/admissions/application-filling/:intApplication/photo
  body: none
  auth: none
}

params:path {
  intApplication: 1
}

docs {
  Returns the applicant photo as a base64 string (or null if not yet uploaded).

  Success (200): data = string (base64-encoded image) or null.
}
