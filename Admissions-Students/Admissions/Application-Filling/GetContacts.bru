meta {
  name: Get Application Contacts
  type: http
  seq: 12
}

post {
  url: {{baseUrl}}/api/v1/admissions/application-filling/contacts
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  [1, 2, 3]
}

docs {
  Returns contact information for a list of application integer IDs.
  Body is an array of intApplication values.

  Success (200): data = List<ApplicationContactResponseDto>.
}
