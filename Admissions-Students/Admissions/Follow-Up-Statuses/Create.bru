meta {
  name: Create Follow-Up Status
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/admissions/follow-up-statuses
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "followUpStatusName": "Pending",
    "followUpStatusCode": "PND",
    "isClose": 0
  }
}

docs {
  Creates a new follow-up status. `isClose`: 1 = this status closes the follow-up cycle.

  Success (201): data = created FollowUpStatusDto.
  Failure: 400 `validation_error`.
}
