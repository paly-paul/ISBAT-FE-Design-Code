meta {
  name: Create Enquiry Source
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/admissions/enquiry-sources
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "enquirySourceName": "Social Media"
  }
}

vars:pre-request {
  baseUrl: https://localhost:44396
}

docs {
  Creates a new enquiry source.
  
  Success (201): data = created EnquirySourceDto.
  Failure: 400 `validation_error`.
}
