meta {
  name: Update Payment Other
  type: http
  seq: 19
}

put {
  url: {{baseUrl}}/api/v1/finance/payment-console/payment-other/:paymentOtherGuid
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

params:path {
  paymentOtherGuid: 3fa85f64-5717-4562-b3fc-2c963f66afa6
}

body:json {
  {
    "amount": 55000,
    "payDate": "2026-07-30",
    "bankGuid": null,
    "remarks": "Corrected hostel fee amount"
  }
}

docs {
  Updates an existing "other" (non-tuition) payment's amount/date/bank/remarks.
  `bankGuid`, `remarks` are optional.

  Success (200): data = updated PaymentOtherResultDto.
  Failure: 400 `validation_error`; 404 `not_found` if no payment with that
  GUID exists.
}
