meta {
  name: Get Outstanding Ledgers
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/v1/finance/payment-console/outstanding-ledgers/:applicationGuid
  body: none
  auth: none
}

params:path {
  applicationGuid: 3fa85f64-5717-4562-b3fc-2c963f66afa6
}

docs {
  Returns the tuition-fee ledger lines still outstanding for the student's
  current program/semester (used to build the "what can they pay" list).

  Success (200): data = array of OutstandingLedgerDto (intLedger,
  semesterGuid, ledgerName, ledgerNum, intCurrency, currencyName, ledgerAmount,
  paidAmount, outstanding).
}
