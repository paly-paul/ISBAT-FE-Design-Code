meta {
  name: Update Payment Nche
  type: http
  seq: 20
}

put {
  url: {{baseUrl}}/api/v1/finance/payment-console/payment-nche/:paymentNcheGuid
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

params:path {
  paymentNcheGuid: 3fa85f64-5717-4562-b3fc-2c963f66afa6
}

body:json {
  {
    "amount": 100000,
    "payDate": "2026-07-30",
    "pnrNumber": "PNR-2026-000123",
    "remarks": "Updated NCHE payment"
  }
}

docs {
  Updates an existing NCHE payment's amount/date/PNR/remarks. `pnrNumber`,
  `remarks` are optional.

  Success (200): data = updated PaymentNcheResultDto.
  Failure: 400 `validation_error`; 404 `not_found` if no payment with that
  GUID exists.
}
