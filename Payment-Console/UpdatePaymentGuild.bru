meta {
  name: Update Payment Guild
  type: http
  seq: 21
}

put {
  url: {{baseUrl}}/api/v1/finance/payment-console/payment-guild/:paymentGuildGuid
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

params:path {
  paymentGuildGuid: 3fa85f64-5717-4562-b3fc-2c963f66afa6
}

body:json {
  {
    "amount": 25000,
    "payDate": "2026-07-30",
    "bankDeposit": "Updated guild bank deposit slip #4522"
  }
}

docs {
  Updates an existing guild association payment's amount/date/bank deposit
  reference. `bankDeposit` is optional.

  Success (200): data = updated PaymentGuildResultDto.
  Failure: 400 `validation_error`; 404 `not_found` if no payment with that
  GUID exists.
}
