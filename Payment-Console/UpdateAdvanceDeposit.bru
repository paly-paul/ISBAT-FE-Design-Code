meta {
  name: Update Advance Deposit
  type: http
  seq: 22
}

put {
  url: {{baseUrl}}/api/v1/finance/payment-console/advance-deposit/:paymentAdvanceGuid
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

params:path {
  paymentAdvanceGuid: 3fa85f64-5717-4562-b3fc-2c963f66afa6
}

body:json {
  {
    "amount": 210000,
    "payDate": "2026-07-30",
    "bankGuid": null,
    "remarks": "Corrected advance deposit amount"
  }
}

docs {
  Updates an existing advance deposit's amount/date/bank/remarks. `bankGuid`,
  `remarks` are optional.

  Success (200): data = updated AdvanceDepositResultDto.
  Failure: 400 `validation_error`; 404 `not_found` if no advance deposit with
  that GUID exists.
}
