meta {
  name: Create Payment
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/api/v1/finance/payment-console/payments
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "applicationGuid": "3fa85f64-5717-4562-b3fc-2c963f66afa6",
    "studentGuid": "3fa85f64-5717-4562-b3fc-2c963f66afa6",
    "amount": 500000,
    "currencyGuid": "3fa85f64-5717-4562-b3fc-2c963f66afa6",
    "receiptBookGuid": "3fa85f64-5717-4562-b3fc-2c963f66afa6",
    "payDate": "2026-07-30",
    "payType": 1,
    "procBankGuid": null,
    "remarks": "Tuition payment for Semester 1"
  }
}

docs {
  Records a tuition payment against the student's outstanding ledgers.
  `payType`: 1=Cash, 2=Cheque, 3=Bank, 4=DemandDraft, 5=Online. `studentGuid`,
  `procBankGuid`, `remarks` are optional.

  Success (201): data = PaymentResultDto (paymentGuid, paymentCode, receipt,
  balance, advanceMessage).
  Failure: 400 `validation_error` if required fields are missing/invalid.
}
