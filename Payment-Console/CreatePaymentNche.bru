meta {
  name: Create Payment Nche
  type: http
  seq: 13
}

post {
  url: {{baseUrl}}/api/v1/finance/payment-console/payment-nche
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "applicationGuid": "3fa85f64-5717-4562-b3fc-2c963f66afa6",
    "studentGuid": "3fa85f64-5717-4562-b3fc-2c963f66afa6",
    "amount": 100000,
    "payDate": "2026-07-30",
    "pnrNumber": "PNR-2026-000123",
    "remarks": "NCHE sponsorship payment"
  }
}

docs {
  Records an NCHE (sponsorship) payment for the student. `studentGuid`,
  `pnrNumber`, `remarks` are optional.

  Success (201): data = PaymentNcheResultDto (paymentNcheGuid, amount,
  remainingBalance).
  Failure: 400 `validation_error` if required fields are missing/invalid.
}
