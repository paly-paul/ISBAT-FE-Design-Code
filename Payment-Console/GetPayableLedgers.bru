meta {
  name: Get Payable Ledgers
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/api/v1/finance/payment-console/payable-ledgers?applicationGuid=3fa85f64-5717-4562-b3fc-2c963f66afa6&studentGuid=3fa85f64-5717-4562-b3fc-2c963f66afa6&amount=500000&intCurrency=1&payDate=2026-07-30
  body: none
  auth: none
}

params:query {
  applicationGuid: 3fa85f64-5717-4562-b3fc-2c963f66afa6
  studentGuid: 3fa85f64-5717-4562-b3fc-2c963f66afa6
  amount: 500000
  intCurrency: 1
  payDate: 2026-07-30
}

docs {
  Given a tuition amount the student wants to pay, returns how that amount
  would be allocated across the outstanding ledger lines (with discount and
  rounding lines included), used to preview a payment before submitting it.
  `studentGuid` is optional.

  Success (200): data = PayableLedgersResultDto (lines: array of
  PayableLedgerDto [intLedger, semesterGuid, ledgerName, ledgerNum, amount,
  intCurrency, currencyName, amtDef, isDiscountLine, isRoundingLine], balance).
}
