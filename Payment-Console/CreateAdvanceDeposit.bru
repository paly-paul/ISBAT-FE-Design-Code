meta {
  name: Create Advance Deposit
  type: http
  seq: 15
}

post {
  url: {{baseUrl}}/api/v1/finance/payment-console/advance-deposit
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "applicationGuid": "3fa85f64-5717-4562-b3fc-2c963f66afa6",
    "studentGuid": "3fa85f64-5717-4562-b3fc-2c963f66afa6",
    "amount": 200000,
    "currencyGuid": "3fa85f64-5717-4562-b3fc-2c963f66afa6",
    "receiptBookGuid": "3fa85f64-5717-4562-b3fc-2c963f66afa6",
    "payDate": "2026-07-30",
    "payType": 1,
    "procBankGuid": null,
    "remarks": "Advance deposit for future semester fees"
  }
}

docs {
  Records an advance deposit that can later be drawn down to fund "other"
  payment lines. `payType`: 1=Cash, 2=Cheque, 3=Bank, 4=DemandDraft, 5=Online.
  `studentGuid`, `procBankGuid`, `remarks` are optional.

  Success (201): data = AdvanceDepositResultDto (paymentAdvanceGuid,
  advPaymentCode, receipt, balance).
  Failure: 400 `validation_error` if required fields are missing/invalid.
}
