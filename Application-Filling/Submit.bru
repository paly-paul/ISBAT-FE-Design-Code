meta {
  name: Submit Application
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/api/v1/admissions/application-filling/:intApplication/submit
  body: json
  auth: none
}

params:path {
  intApplication: 15
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "appRefNo": "APP-2026-0001",
    "declarationAccepted": true
  }
}

vars:pre-request {
  baseUrl: http://localhost:5200
}

docs {
  Submits a completed application. `declarationAccepted` must be true.
  
  Success (200): data = SubmitApplicationResponseDto.
  Failure: 400 `validation_error` (declaration not accepted, missing required fields).
}
