meta {
  name: Lookup Application By Ref No
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/admissions/application-filling/lookup?appRefNo=APP202651/2
  body: none
  auth: none
}

params:query {
  appRefNo: APP202651/2
}

vars:pre-request {
  baseUrl: http://localhost:5200
}

docs {
  Looks up an application by its reference number.
  
  Success (200): data = LookupApplicationResponse (applicationGuid, intApplication, status, etc.).
  Failure: 404 `not_found`.
}
