meta {
  name: Get Application Detail
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/api/v1/admissions/application-filling/:intApplication/detail
  body: none
  auth: none
}

params:path {
  intApplication: 1
}

docs {
  Returns the full detail of an application by its integer ID.

  Success (200): data = ApplicationDetailDto.
  Failure: 404 `not_found`.
}
