meta {
  name: Upload Application Photo
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/api/v1/admissions/application-filling/photo
  body: multipartForm
  auth: none
}

body:multipart-form {
  appRefNo: APP202651/15
  photo: @file(C:\Users\Training002\Pictures\Screenshots\Screenshot 2026-05-07 173849.png) @contentType(image/png)
}

vars:pre-request {
  baseUrl: http://localhost:5200
}

docs {
  Uploads or replaces the applicant's passport-size photo. Accepts multipart/form-data.
  The `photo` field should be the image file.
  
  Success (200): data = true.
  Failure: 400 `validation_error`.
}
