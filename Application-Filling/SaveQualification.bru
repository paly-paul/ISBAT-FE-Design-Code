meta {
  name: Save Application Qualification
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/api/v1/admissions/application-filling/qualifications
  body: multipartForm
  auth: none
}

body:multipart-form {
  appRefNo: APP202651/15
  institution: Kampala Secondary School
  university: asd
  passYear: 2020
  grade: A
  yearsTaken: 4
  proofFile: @file(C:\Users\Training002\Pictures\Screenshots\Screenshot 2026-05-07 173849.png) @contentType(image/png)
}

vars:pre-request {
  baseUrl: http://localhost:5200
}

docs {
  Adds or updates an academic qualification on an application. Accepts multipart/form-data
  because an optional proof file can be uploaded.
  
  Success (200): data = SaveQualificationResponseDto.
  Failure: 400 `validation_error`.
}
