meta {
  name: Payment Search Applications
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/v1/admissions/application-filling/payment-search
  body: none
  auth: none
}

params:query {
  searchTerm: john
  pageNumber: 1
  pageSize: 20
}

docs {
  Searches applications eligible for payment by student name, email, phone, or ref no.

  Query params:
  - `searchTerm` (optional): partial match on student name, email, phone, or application ref no.
  - `pageNumber`: 1-based page number (default 1).
  - `pageSize`: results per page (default 20).

  Success (200): paginated list of application summaries.
}
