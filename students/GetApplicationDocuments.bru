meta {
  name: Get Application Documents
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/api/v1/students/applications/:applicationGuid/documents
  body: none
  auth: none
}

params:path {
  applicationGuid: 3fa85f64-5717-4562-b3fc-2c963f66afa6
}

docs {
  Returns the applicant's/student's photo, core identity documents, and
  qualification proof documents for an application, keyed by `applicationGuid`.

  This is the endpoint the frontend should call for this data — it proxies to the
  Admissions module internally (Students has no direct DB access to that data),
  so there is no need to call the Admissions `application-filling/{guid}/documents`
  endpoint directly from the frontend.

  Success (200): data = ApplicationDocumentsDto
  ```json
  {
    "applicationGuid": "3fa85f64-5717-4562-b3fc-2c963f66afa6",
    "documents": [
      { "documentType": "Photo", "uploaded": true, "fileName": "photo.jpg", "contentType": "image/jpeg", "url": "https://...presigned..." },
      { "documentType": "NationalId", "uploaded": false, "fileName": null, "contentType": null, "url": null },
      { "documentType": "Passport", "uploaded": true, "fileName": "passport.pdf", "contentType": "application/pdf", "url": "https://...presigned..." },
      { "documentType": "Visa", "uploaded": false, "fileName": null, "contentType": null, "url": null },
      { "documentType": "Refugee", "uploaded": false, "fileName": null, "contentType": null, "url": null }
    ],
    "qualifications": [
      {
        "applicationQualGuid": "9c1a2b3c-4d5e-6f70-8192-a3b4c5d6e7f8",
        "institution": "St. Mary's College",
        "university": "Makerere University",
        "uploaded": true,
        "fileName": "transcript.pdf",
        "contentType": "application/pdf",
        "url": "https://...presigned..."
      }
    ]
  }
  ```

  `documents` always contains exactly 5 entries (Photo, NationalId, Passport, Visa,
  Refugee) regardless of upload status — check `uploaded` rather than array length.
  `qualifications` has one entry per qualification added via Admissions
  `POST /qualifications`.

  Failure: 404 `not_found` — application does not exist.
}
