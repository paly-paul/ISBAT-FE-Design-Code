meta {
  name: List Students
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/v1/students?page=1&pageSize=25
  body: none
  auth: none
}

params:query {
  searchTerm: ~
  page: 1
  pageSize: 25
}

docs {
  Returns a paginated list of students. `searchTerm` matches studentNum,
  studentRegNo, or studentName.

  Success (200): data = PagedResult<StudentDto>.
}
