meta {
  name: Get Student Enrolled By Employee
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/students/enrolled-by/:employeeGuid
  body: none
  auth: none
}

params:path {
  employeeGuid: 3fa85f64-5717-4562-b3fc-2c963f66afa6
}

docs {
  Returns student details alongside the employee who enrolled them. The employee
  is fetched from the Identity service in the same request (cross-module call).

  Success response (200):
  {
    "success": true,
    "data": {
      "student": { "module": "Students", "status": "OK" },
      "enrolledBy": {
        "employeeGuid": "3fa85f64-5717-4562-b3fc-2c963f66afa6",
        "shortCode": "EMP001",
        "empName": "John Doe",
        "surname": "Doe",
        "firstName": "John",
        "otherName": null,
        "emailId": "john.doe@example.com"
      }
    }
  }

  Failure: 404 `not_found` — no employee with that GUID.
}
