meta {
  name: Get Unread Count
  type: http
  seq: 1
}

get {
  url: {{notificationsBaseUrl}}/api/v1/notifications/unread-count
  body: none
  auth: none
}

docs {
  The number the notification bell displays. Call this on login — it is the only
  thing that accounts for notifications raised while the user was logged out;
  the SignalR hub can never supply them.

  Scoped to the caller's own employee GUID (the `user_guid` claim, forwarded by
  the gateway as `X-User-Guid`). Users with no linked employee record have no
  claim, and always get 0.

  Success (200): `data` is the integer count of unread notifications.
}
