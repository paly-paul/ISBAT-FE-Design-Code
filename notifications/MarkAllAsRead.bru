meta {
  name: Mark All As Read
  type: http
  seq: 4
}

post {
  url: {{notificationsBaseUrl}}/api/v1/notifications/read-all
  body: none
  auth: none
}

docs {
  Clears the badge in one call. Affects only the caller's own notifications.

  Success (200): `data` is the number of rows marked read — 0 when there was
  nothing unread, which is a success, not an error.
}
