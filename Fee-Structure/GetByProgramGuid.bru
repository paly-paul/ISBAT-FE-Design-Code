meta {
  name: Get Fee Headers By Program
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/academic/Programfee-structure/:programGuid
  body: none
  auth: none
}

params:path {
  programGuid: 3fa85f64-5717-4562-b3fc-2c963f66afa6
}

docs {
  Returns all fee headers and their fee lines for a program.
  Note: the URL segment uses "Programfee-structure" (mixed case) as defined in the service.

  Success (200): data is an array of ProgramFeeHd objects, each with a nested programFees array.
}
