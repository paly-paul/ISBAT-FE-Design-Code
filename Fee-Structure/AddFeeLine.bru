meta {
  name: Add Fee Line
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/v1/academic/Programfee-structure/fee
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "feeHdGuid": "3fa85f64-5717-4562-b3fc-2c963f66afa6",
    "ledgerGuid": "7c9e6679-7425-40de-944b-e07fc1f90ae7",
    "programGuid": "3fa85f64-5717-4562-b3fc-2c963f66afa6",
    "currencyGuid": "a1b2c3d4-e5f6-4789-abcd-ef0123456789",
    "semCode": 101,
    "ledgerNum": 1,
    "amount": 1500000.00,
    "isEdit": false
  }
}

docs {
  Adds or updates a fee line (ledger amount) on an existing fee header for a specific program semester.
  isEdit: true = update existing line, false = create new.
  All GUIDs are required. semCode identifies which semester the fee applies to.

  Success: 201 Created.
  Failures: 400 validation_error (any required GUID empty), 404 not_found (fee header not found).
}
