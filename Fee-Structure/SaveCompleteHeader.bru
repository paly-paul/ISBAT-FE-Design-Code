meta {
  name: Save Complete Fee Header
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/v1/academic/Programfee-structure/hd/save-complete
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "programGuid": "3fa85f64-5717-4562-b3fc-2c963f66afa6",
    "feeCode": "TUI",
    "feeDesc": "Tuition Fee",
    "status": true,
    "localOrForeign": false,
    "lef": null,
    "cef": null,
    "ace": null,
    "lec": null,
    "cec": null,
    "acec": null,
    "calcType": 1,
    "amtPer": null,
    "intakeGuid": null,
    "feeLines": [
      {
        "semesterGuid": "3fa85f64-5717-4562-b3fc-2c963f66afa6",
        "ledgerGuid": "7c9e6679-7425-40de-944b-e07fc1f90ae7",
        "currencyGuid": "a1b2c3d4-e5f6-4789-abcd-ef0123456789",
        "ledgerNum": 1,
        "amount": 1500000.00
      }
    ]
  }
}

docs {
  Creates a fee header together with all its fee lines in a single call.

  programGuid: required - the program this fee structure belongs to.
  semesterGuid: required per line - must belong to the same program (same-service lookup).
  ledgerGuid / currencyGuid: cross-service Finance GUIDs, passed through as-is.

  Success: 201 Created, data is the created fee header with all fee lines.
  Failures: 404 not_found (program, intake, or semester not found), 400 duplicate_fee_code.
}
