meta {
  name: Update Complete Fee Header
  type: http
  seq: 7
}

put {
  url: {{baseUrl}}/api/v1/academic/Programfee-structure/hd/:feeHdGuid/update-complete
  body: json
  auth: none
}

params:path {
  feeHdGuid: 3fa85f64-5717-4562-b3fc-2c963f66afa6
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "feeHdGuid": "3fa85f64-5717-4562-b3fc-2c963f66afa6",
    "programGuid": "3fa85f64-5717-4562-b3fc-2c963f66afa6",
    "feeCode": "TUI",
    "feeDesc": "Tuition Fee",
    "status": true,
    "localOrForeign": false,
    "lef": null,
    "cef": null,
    "ace": null,
    "lec": null,
    "cec": null,
    "acec": null,
    "calcType": 1,
    "amtPer": null,
    "intakeGuid": null,
    "feeLines": [
      {
        "semesterGuid": "3fa85f64-5717-4562-b3fc-2c963f66afa6",
        "ledgerGuid": "7c9e6679-7425-40de-944b-e07fc1f90ae7",
        "currencyGuid": "a1b2c3d4-e5f6-4789-abcd-ef0123456789",
        "ledgerNum": 1,
        "amount": 1500000.00
      }
    ]
  }
}

docs {
  Updates a fee header and its fee lines in a single call.
  feeHdGuid in the URL path identifies the header to update (body feeHdGuid is overridden by the route).

  Fee lines behaviour:
    - Existing line with same (semester, ledger) -> updated in-place (amount, ledgerNum, currencyGuid).
    - New line not previously present -> inserted.
    - Existing lines not included in feeLines -> left untouched.

  Success (200): data is the updated fee header with processed fee lines.
  Failures: 404 not_found (fee header, program, intake, or semester not found), 400 duplicate_fee_code.
}
