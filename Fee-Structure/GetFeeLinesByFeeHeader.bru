meta {
  name: Get Fee Lines by Fee Header
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/api/v1/academic/Programfee-structure/fee-lines/:feeHdGuid
  body: none
  auth: none
}

params:path {
  feeHdGuid: 3fa85f64-5717-4562-b3fc-2c963f66afa6
}

docs {
  Returns all fee lines for a specific fee header. Each line includes ledger name (enriched from
  Finance service), currency name (enriched from Finance service), ledger number, and amount.

  Success (200): data is an array of ProgramFeeLine objects with fields:
    programGuid, semesterGuid, ledgerGuid, ledgerName, ledgerNum, currencyGuid, currencyName, amount.
  Failures: 404 not_found if feeHdGuid does not match any fee header.
}
